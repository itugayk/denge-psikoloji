---
import Icon from './Icon.astro';
import { site } from '../data/site';
---
<section class="container-x py-20 md:py-28">
  <div class="grain relative overflow-hidden rounded-[2.5rem] bg-sage-600 px-7 py-16 text-center shadow-soft-lg sm:px-12 md:py-20">
    <div class="pointer-events-none absolute inset-0 -z-0">
      <div class="absolute -top-24 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-sage-400/30 blur-3xl"></div>
    </div>
    <div data-reveal-group class="relative mx-auto max-w-2xl">
      <span class="eyebrow reveal justify-center text-sand-100/70">
        <span class="h-px w-6 bg-sand-100/40"></span>
        İlk adım
      </span>
      <h2 class="reveal mt-5 text-balance font-serif text-3xl leading-tight text-sand-50 sm:text-4xl">
        Hazır olduğunuzda, buradayız
      </h2>
      <p class="reveal mt-5 text-pretty leading-relaxed text-sand-100/80">
        Yardım istemek bir güç göstergesidir. İlk görüşme için bize ulaşın;
        size en uygun terapistle, gizliliğiniz korunarak tanışmanıza yardımcı olalım.
        Acele yok — siz hazır olduğunuzda başlıyoruz.
      </p>
      <div class="reveal mt-9 flex flex-wrap items-center justify-center gap-4">
        <a href="/randevu" class="btn bg-sand-50 text-sage-700 hover:bg-white hover:-translate-y-0.5 hover:shadow-soft">
          Randevu Al
          <Icon name="arrow" class="h-4 w-4" />
        </a>
        <a href={`tel:${site.phoneHref}`} class="btn border border-sand-100/30 text-sand-50 hover:bg-sand-100/10">
          <Icon name="phone" class="h-4 w-4" />
          {site.phone}
        </a>
      </div>
      <p class="reveal mt-7 inline-flex items-center gap-2 text-sm text-sand-100/65">
        <Icon name="lock" class="h-4 w-4" />
        Paylaştığınız her şey gizlilik ilkesiyle korunur
      </p>
    </div>
  </div>
</section>
