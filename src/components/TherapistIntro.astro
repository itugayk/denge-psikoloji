---
import Icon from './Icon.astro';
import { site } from '../data/site';
interface Props {
  variant?: 'home' | 'full';
}
const { variant = 'home' } = Astro.props;
---
<section class="container-x py-20 md:py-28">
  <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-16">
    <!-- Portre — soyut, sıcak -->
    <div data-reveal-group class="lg:col-span-5">
      <div class="reveal relative mx-auto max-w-sm">
        <div class="relative aspect-[4/5] overflow-hidden rounded-[2.5rem] shadow-soft">
          <svg viewBox="0 0 320 400" class="h-full w-full" preserveAspectRatio="xMidYMid slice" role="img" aria-label={`${site.founder.name} portresi`}>
            <defs>
              <linearGradient id="pg" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#e6ddd0" />
                <stop offset="1" stop-color="#d6c8b4" />
              </linearGradient>
            </defs>
            <rect width="320" height="400" fill="url(#pg)" />
            <circle cx="160" cy="150" r="62" fill="#8a9a8b" opacity="0.85" />
            <path d="M70 400 C 70 300 110 250 160 250 C 210 250 250 300 250 400 Z" fill="#8a9a8b" opacity="0.85" />
            <circle cx="160" cy="150" r="62" fill="none" stroke="#f0ebe3" stroke-opacity="0.35" stroke-width="2" />
          </svg>
          <div class="grain absolute inset-0"></div>
        </div>
        <div class="absolute -right-4 -top-4 rounded-2xl border border-sand-200/80 bg-white/90 px-4 py-3 shadow-soft backdrop-blur">
          <p class="text-xs text-sage-500/80">Deneyim</p>
          <p class="font-serif text-lg text-sage-700">12+ yıl</p>
        </div>
      </div>
    </div>

    <div data-reveal-group class="lg:col-span-7">
      <span class="eyebrow reveal">
        <span class="h-px w-6 bg-sage-400/60"></span>
        Terapistiniz
      </span>
      <h2 class="reveal mt-4 text-balance font-serif text-3xl leading-tight text-sage-700 sm:text-4xl">
        {site.founder.name}
      </h2>
      <p class="reveal mt-2 text-sage-500">{site.founder.title}</p>

      <p class="reveal mt-6 max-w-prose2 text-pretty leading-relaxed text-sage-600/90">
        On iki yılı aşkın süredir, kaygı, depresyon, ilişki zorlukları ve travma alanlarında
        bireylere ve çiftlere eşlik ediyorum. İnanıyorum ki iyileşme, yargılanmadığını
        hisseden, güvenli bir alanda başlar.
      </p>
      {variant === 'home' && (
        <p class="reveal mt-4 max-w-prose2 text-pretty leading-relaxed text-sage-600/90">
          Her insanın hikâyesi biriciktir; bu yüzden hazır kalıplar yerine, size özel ve
          kendi hızınızda ilerleyen bir süreç kurarız.
        </p>
      )}

      <ul data-reveal-group class="reveal mt-8 grid gap-3 sm:grid-cols-2">
        {[
          'Bilişsel Davranışçı Terapi (BDT)',
          'Şema Terapi',
          'EMDR (Travma)',
          'Çift & İlişki Terapisi',
        ].map((m) => (
          <li class="reveal flex items-center gap-3 text-sm text-sage-600/90">
            <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-sage-400/12 text-sage-500">
              <Icon name="check" class="h-4 w-4" />
            </span>
            {m}
          </li>
        ))}
      </ul>

      {variant === 'home' && (
        <a href="/hakkimizda" class="reveal mt-9 inline-flex items-center gap-2 text-sm font-medium text-sage-600 transition-colors hover:text-sage-800">
          Hakkımda daha fazlası
          <Icon name="arrow" class="h-4 w-4" />
        </a>
      )}
    </div>
  </div>
</section>
