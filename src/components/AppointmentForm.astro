---
import Icon from '../components/Icon.astro';
import { specialties } from '../data/site';
---
<form
  data-appointment-form
  class="space-y-6"
  novalidate
>
  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="ad" class="mb-2 block text-sm font-medium text-sage-700">Adınız <span class="text-clay-500">*</span></label>
      <input id="ad" name="ad" type="text" required autocomplete="given-name"
        class="w-full rounded-2xl border border-sand-300/80 bg-white/80 px-4 py-3 text-sm text-ink placeholder:text-sage-400/70 transition-colors focus:border-sage-400"
        placeholder="Yalnızca adınız yeterli" />
    </div>
    <div>
      <label for="tel" class="mb-2 block text-sm font-medium text-sage-700">Telefon <span class="text-clay-500">*</span></label>
      <input id="tel" name="tel" type="tel" required autocomplete="tel"
        class="w-full rounded-2xl border border-sand-300/80 bg-white/80 px-4 py-3 text-sm text-ink placeholder:text-sage-400/70 transition-colors focus:border-sage-400"
        placeholder="Size ulaşabileceğimiz numara" />
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label for="eposta" class="mb-2 block text-sm font-medium text-sage-700">E-posta</label>
      <input id="eposta" name="eposta" type="email" autocomplete="email"
        class="w-full rounded-2xl border border-sand-300/80 bg-white/80 px-4 py-3 text-sm text-ink placeholder:text-sage-400/70 transition-colors focus:border-sage-400"
        placeholder="İsteğe bağlı" />
    </div>
    <div>
      <label for="tur" class="mb-2 block text-sm font-medium text-sage-700">Görüşme türü</label>
      <select id="tur" name="tur"
        class="w-full rounded-2xl border border-sand-300/80 bg-white/80 px-4 py-3 text-sm text-ink transition-colors focus:border-sage-400">
        <option value="bireysel">Bireysel terapi</option>
        <option value="cift">Çift terapisi</option>
        <option value="cocuk-ergen">Çocuk & ergen</option>
        <option value="online">Online terapi</option>
        <option value="emin-degilim">Emin değilim</option>
      </select>
    </div>
  </div>

  <div>
    <label for="konu" class="mb-2 block text-sm font-medium text-sage-700">İlgilendiğiniz alan</label>
    <select id="konu" name="konu"
      class="w-full rounded-2xl border border-sand-300/80 bg-white/80 px-4 py-3 text-sm text-ink transition-colors focus:border-sage-400">
      <option value="">Seçmek isterseniz…</option>
      {specialties.map((s) => <option value={s.slug}>{s.title}</option>)}
    </select>
  </div>

  <div>
    <label for="zaman" class="mb-2 block text-sm font-medium text-sage-700">Tercih ettiğiniz zaman</label>
    <input id="zaman" name="zaman" type="text"
      class="w-full rounded-2xl border border-sand-300/80 bg-white/80 px-4 py-3 text-sm text-ink placeholder:text-sage-400/70 transition-colors focus:border-sage-400"
      placeholder="Örn. hafta içi akşam, hafta sonu sabah…" />
  </div>

  <div>
    <label for="mesaj" class="mb-2 block text-sm font-medium text-sage-700">Eklemek istedikleriniz</label>
    <textarea id="mesaj" name="mesaj" rows="4"
      class="w-full resize-none rounded-2xl border border-sand-300/80 bg-white/80 px-4 py-3 text-sm text-ink placeholder:text-sage-400/70 transition-colors focus:border-sage-400"
      placeholder="Paylaşmak istediğiniz kadarı yeterli. Dilemezseniz boş bırakabilirsiniz."></textarea>
  </div>

  <div class="flex items-start gap-3 rounded-2xl bg-sage-50/80 p-4">
    <input id="onam" name="onam" type="checkbox" required class="mt-1 h-4 w-4 shrink-0 rounded border-sand-300 text-sage-500 focus:ring-sage-400" />
    <label for="onam" class="text-sm leading-relaxed text-sage-600/90">
      Bilgilerimin yalnızca randevu sürecim için kullanılacağını ve gizlilik ilkesiyle
      korunacağını biliyor, iletişime geçilmesine onay veriyorum. <span class="text-clay-500">*</span>
    </label>
  </div>

  <button type="submit" class="btn-primary w-full sm:w-auto">
    Randevu Talebi Gönder
    <Icon name="arrow" class="h-4 w-4" />
  </button>

  <!-- Geri bildirim -->
  <div data-form-feedback hidden class="rounded-2xl border border-sage-300/70 bg-sage-50 p-5">
    <div class="flex items-start gap-3">
      <span class="grid h-9 w-9 shrink-0 place-items-center rounded-full bg-sage-400/20 text-sage-600"><Icon name="check" class="h-5 w-5" /></span>
      <div>
        <p class="font-serif text-lg text-sage-700">Talebiniz alındı</p>
        <p class="mt-1 text-sm leading-relaxed text-sage-600/85">
          En kısa sürede, gizliliğiniz korunarak size geri dönüş yapacağız. Bu adımı attığınız için kendinize teşekkür edin.
        </p>
        <p class="mt-2 text-xs text-sage-500/70">(Bu bir demo formdur — gönderilen veriler kaydedilmez.)</p>
      </div>
    </div>
  </div>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-appointment-form]');
  const feedback = document.querySelector<HTMLElement>('[data-form-feedback]');
  if (form && feedback) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      feedback.hidden = false;
      form.querySelectorAll('input, select, textarea, button').forEach((el) => {
        (el as HTMLInputElement).disabled = true;
      });
      feedback.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  }
</script>
