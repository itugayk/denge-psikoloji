---
import Icon from './Icon.astro';
import { approachSteps } from '../data/site';
---
<section class="relative overflow-hidden bg-sand-100/60 py-20 md:py-28">
  <div class="grain absolute inset-0 opacity-60"></div>
  <div class="container-x relative">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div data-reveal-group class="lg:col-span-5">
        <span class="eyebrow reveal">
          <span class="h-px w-6 bg-sage-400/60"></span>
          Terapi Yaklaşımı
        </span>
        <h2 class="reveal mt-4 text-balance font-serif text-3xl leading-tight text-sage-700 sm:text-4xl">
          Güvenle başlayan, sizin hızınızda ilerleyen bir süreç
        </h2>
        <p class="reveal mt-5 text-pretty leading-relaxed text-sage-600/90">
          Terapi bir yarış değil. Önce güvenli bir bağ kurar, sonra yaşadıklarınızı
          birlikte anlamaya başlarız. Her adımda mahremiyetiniz korunur.
        </p>

        <div data-reveal-group class="mt-8 space-y-4">
          <div class="reveal flex items-start gap-4 rounded-2xl border border-sand-200/80 bg-white/70 p-5">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-sage-400/12 text-sage-500">
              <Icon name="lock" class="h-5 w-5" />
            </span>
            <div>
              <h3 class="font-serif text-base text-sage-700">Gizlilik her şeyden önce</h3>
              <p class="mt-1 text-sm leading-relaxed text-sage-600/85">Tüm görüşmeler mesleki sır ve etik ilkelerle korunur.</p>
            </div>
          </div>
          <div class="reveal flex items-start gap-4 rounded-2xl border border-sand-200/80 bg-white/70 p-5">
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-sage-400/12 text-sage-500">
              <Icon name="video" class="h-5 w-5" />
            </span>
            <div>
              <h3 class="font-serif text-base text-sage-700">Online terapi seçeneği</h3>
              <p class="mt-1 text-sm leading-relaxed text-sage-600/85">Neredeyseniz orada — güvenli ve şifreli görüşme ortamında.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Süreç adımları -->
      <div data-reveal-group class="lg:col-span-7">
        <ol class="relative space-y-2">
          {approachSteps.map((step, i) => (
            <li class="reveal group relative flex gap-6 rounded-3xl p-6 transition-colors duration-500 hover:bg-white/70">
              <div class="flex flex-col items-center">
                <span class="font-serif text-2xl text-sage-300 transition-colors group-hover:text-sage-400">{step.no}</span>
                {i < approachSteps.length - 1 && (
                  <span class="mt-2 w-px flex-1 bg-sand-300/70"></span>
                )}
              </div>
              <div class="pb-4">
                <h3 class="font-serif text-xl text-sage-700">{step.title}</h3>
                <p class="mt-2 max-w-md text-pretty leading-relaxed text-sage-600/85">{step.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>
