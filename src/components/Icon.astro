  link: '<path d="M9 12h6"/><path d="M10.5 7.5h-2A4.5 4.5 0 0 0 4 12a4.5 4.5 0 0 0 4.5 4.5h2"/><path d="M13.5 7.5h2A4.5 4.5 0 0 1 20 12a4.5 4.5 0 0 1-4.5 4.5h-2"/>',
