---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import AppointmentForm from '../components/AppointmentForm.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const assurances = [
  { icon: 'lock', t: 'Tam gizlilik', d: 'Bilgileriniz yalnızca süreç için kullanılır, üçüncü kişilerle paylaşılmaz.' },
  { icon: 'clock', t: 'Hızlı dönüş', d: 'Talebinizi aldıktan sonra en kısa sürede size geri dönüş yaparız.' },
  { icon: 'heart', t: 'Baskısız süreç', d: 'İlk görüşme bir tanışmadır; devam etmek tamamen sizin tercihiniz.' },
];
---
<Layout title="Randevu Al" description="Denge Psikoloji & Terapi'den gizlilik odaklı randevu talebi. Bireysel, çift, çocuk-ergen ve online terapi için ilk adımı atın.">
  <PageHero eyebrow="Randevu" title="İlk adımı atmak, en cesur adımdır">
    <p>
      Aşağıdaki formu doldurarak randevu talebinde bulunabilirsiniz. Paylaştığınız her bilgi
      gizlilik ilkesiyle korunur. Acele yok — yalnızca hazır hissettiğiniz kadarını paylaşın.
    </p>
  </PageHero>

  <section class="container-x pb-8">
    <div class="grid gap-10 lg:grid-cols-12 lg:gap-14">
      <!-- Form -->
      <div data-reveal-group class="lg:col-span-7">
        <div class="reveal card p-7 sm:p-9">
          <AppointmentForm />
        </div>
      </div>

      <!-- Yan panel -->
      <aside data-reveal-group class="lg:col-span-5">
        <!-- Mahremiyet notu -->
        <div class="reveal grain relative overflow-hidden rounded-3xl bg-sage-600 p-7 text-sand-50">
          <div class="relative">
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-sand-100/15"><Icon name="lock" class="h-6 w-6" /></span>
            <h2 class="mt-5 font-serif text-xl">Mahremiyetiniz güvende</h2>
            <p class="mt-3 text-pretty text-sm leading-relaxed text-sand-100/85">
              Bu form üzerinden ilettiğiniz bilgiler yalnızca sizinle iletişime geçmek ve
              randevunuzu planlamak için kullanılır. Hiçbir bilgi pazarlama amacıyla
              kullanılmaz, üçüncü kişilerle paylaşılmaz ve güvenli biçimde saklanır.
            </p>
          </div>
        </div>

        <!-- Güvenceler -->
        <div class="reveal mt-6 space-y-3">
          {assurances.map((a) => (
            <div class="flex items-start gap-4 rounded-2xl border border-sand-200/80 bg-white/60 p-5">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-sage-400/12 text-sage-500"><Icon name={a.icon} class="h-5 w-5" /></span>
              <div>
                <h3 class="font-serif text-base text-sage-700">{a.t}</h3>
                <p class="mt-1 text-sm leading-relaxed text-sage-600/85">{a.d}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- Doğrudan iletişim -->
        <div class="reveal mt-6 rounded-2xl border border-sand-200/80 bg-sand-100/50 p-6">
          <p class="text-sm font-medium text-sage-700">Konuşmayı tercih ederseniz</p>
          <div class="mt-4 space-y-3 text-sm">
            <a href={`tel:${site.phoneHref}`} class="flex items-center gap-3 text-sage-600 transition-colors hover:text-sage-800">
              <Icon name="phone" class="h-4 w-4 text-sage-400" /> {site.phone}
            </a>
            <a href={`mailto:${site.email}`} class="flex items-center gap-3 text-sage-600 transition-colors hover:text-sage-800">
              <Icon name="mail" class="h-4 w-4 text-sage-400" /> {site.email}
            </a>
            <p class="flex items-center gap-3 text-sage-600/85">
              <Icon name="clock" class="h-4 w-4 text-sage-400" /> {site.hours}
            </p>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Layout>
